<?xml version="1.0" encoding="utf-8"?>
<!-- what IncidentDetailFragment asks for a new update: a message and/or a new status -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="10dp"
    android:paddingEnd="24dp">

    <EditText
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/update_message_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="5"
        android:minHeight="48dp" />

    <!-- hidden for whoever the server won't let change the status -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:checkedChip="@+id/statusUnchangedChip"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/statusUnchangedChip"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/update_status_unchanged" />

        <com.google.android.material.chip.Chip
            android:id="@+id/statusAnalysisChip"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incident_analysis" />

        <com.google.android.material.chip.Chip
            android:id="@+id/statusResolvedChip"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/incident_resolved" />

    </com.google.android.material.chip.ChipGroup>

</LinearLayout>
