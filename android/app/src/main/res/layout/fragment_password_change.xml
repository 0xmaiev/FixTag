<?xml version="1.0" encoding="utf-8"?>
<!-- scrolls, so the keyboard can't hide the fields between the header and the footer -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.PasswordChangeFragment">

    <LinearLayout
        android:id="@+id/passwordChangeFormLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="25dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/passwordChangeIntro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:text="@string/password_change_intro" />

        <TextView
            android:id="@+id/currentPasswordTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/currentPassword"
            android:text="@string/label_current_password" />

        <EditText
            android:id="@+id/currentPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:minHeight="50dp"
            android:selectAllOnFocus="true" />

        <TextView
            android:id="@+id/newPasswordTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/newPassword"
            android:text="@string/label_new_password" />

        <!-- "newPassword" lets a password manager offer to generate and save one -->
        <EditText
            android:id="@+id/newPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="newPassword"
            android:hint="@string/new_password_hint"
            android:imeActionLabel="@string/confirm"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:minHeight="50dp"
            android:selectAllOnFocus="true" />

        <TextView
            android:id="@+id/failed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/password_change_failed"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <Button
            android:id="@+id/confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="25dp"
            android:text="@string/confirm" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>