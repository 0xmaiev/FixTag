<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.fragments.NewOrganizationFragment">

    <LinearLayout
        android:id="@+id/headerLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/material_dynamic_neutral10"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|start"
            android:layout_margin="10dp"
            android:background="@color/material_dynamic_neutral10"
            android:gravity="center|start"
            android:maxWidth="35dp"
            android:maxHeight="35dp"
            android:minWidth="10dp"
            android:minHeight="10dp"
            android:textColor="@color/white"
            android:textColorLink="@color/material_dynamic_neutral10"
            android:textSize="11sp"
            app:icon="@android:drawable/ic_media_rew"
            app:iconGravity="top"
            app:iconSize="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center|start"
            android:layout_margin="10dp"
            android:gravity="center|start"
            android:text="@string/new_organization_fragment_title"
            android:textColor="@color/white"
            android:textSize="24sp" />

    </LinearLayout>


    <Space
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:layout_marginStart="10dp"
        app:cardCornerRadius="5dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:id="@+id/organizationFormLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nameLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="10dp"
                android:gravity="start"
                android:text="@string/label_name"
                android:textAlignment="viewStart"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/organizationNameLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="fill|fill_horizontal"
                    android:height="25dp"
                    android:autofillHints="name"
                    android:elegantTextHeight="false"
                    android:gravity="fill|fill_horizontal"
                    android:hint="@string/name_hint"
                    android:inputType="text"
                    android:labelFor="@string/label_name"
                    android:lineHeight="25dp"
                    android:minHeight="25dp"
                    android:textSize="18sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/formBottomLinearLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical">

                <com.google.android.material.chip.Chip
                    android:id="@+id/createOrganizationButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="50dp"
                    android:elevation="6dp"
                    android:text="@string/save"
                    android:textAlignment="center"
                    android:textColor="@color/material_dynamic_primary100"
                    app:chipBackgroundColor="@color/material_dynamic_primary10" />

                <ProgressBar
                    android:id="@+id/loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="64dp"
                    android:layout_marginBottom="64dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <Space
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

</LinearLayout>