<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.fragments.NewOrganizationFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/material_dynamic_neutral10"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/white"
        app:title="@string/new_organization_fragment_title"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- a card stacks its children like a FrameLayout, so it gets exactly one -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardCornerRadius="5dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:id="@+id/organizationFormLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nameLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginStart="10dp"
                    android:gravity="start"
                    android:text="@string/label_name"
                    android:textAlignment="viewStart"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/organizationNameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="fill|fill_horizontal"
                        android:height="25dp"
                        android:autofillHints="name"
                        android:elegantTextHeight="false"
                        android:gravity="fill|fill_horizontal"
                        android:hint="@string/name_hint"
                        android:inputType="text"
                        android:labelFor="@string/label_name"
                        android:lineHeight="25dp"
                        android:minHeight="25dp"
                        android:textSize="18sp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>

    <com.google.android.material.chip.Chip
        android:id="@+id/createOrganizationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:elevation="6dp"
        android:text="@string/save"
        android:textAlignment="center"
        android:textColor="@color/material_dynamic_primary100"
        app:chipBackgroundColor="@color/material_dynamic_primary10" />

</LinearLayout>